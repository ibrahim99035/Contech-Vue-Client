# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.local

# Environment — real values live in .env, which is never committed.
# VITE_* values are inlined into the bundle at build time, so keep secrets out
# of them entirely; anything prefixed VITE_ is public once shipped.
.env
.env.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test / tooling output
coverage/
.playwright-mcp/
.vite/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp

# Local code-index cache
.code-graph/
