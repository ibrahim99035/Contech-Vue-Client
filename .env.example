# Contech IoT Webapp — Environment Example
# Copy to `.env` and fill in real values. `.env` is git-ignored.
#
# NOTE: every VITE_* value is inlined into the JavaScript bundle at build time
# and is therefore PUBLIC. Never put a secret here.

# Origin of the API server, with NO trailing slash and NO `/api` suffix —
# call sites already carry their own `/api/...` or `/admin/dashboard/...`
# prefix. Leave empty to stay same-origin, which is what you want under
# `npm run dev` because the Vite dev server proxies those paths to localhost.
#
# Required for production builds hosted separately from the API, e.g. Vercel:
#   VITE_API_URL=https://api-bridge.contech-iot.com
VITE_API_URL=

# Google OAuth client ID. Public identifier, not a secret — the matching
# client secret stays server-side. The authorized JavaScript origin for this
# value must include the host serving the app, e.g.
# https://contech-vue-client.vercel.app
VITE_GOOGLE_CLIENT_ID=
